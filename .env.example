APP_ENV=development
APP_NAME=NexEase
APP_VERSION=0.2.0
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nexease_development
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
FRONTEND_BASE_URL=http://127.0.0.1:3000
EMAIL_MODE=development

# SaaS: preserve existing .env and append these values on upgrade.
SAAS_ENFORCEMENT=true
OWNER_ENCRYPTION_KEY=
# Final monthly checkout amounts start at INR 749 / 1499 / 1999.
# All plan edits and publication are performed in /owner.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_TERMS_READY=false
BILLING_TERMS_URL=
PRIVACY_URL=
REFUND_POLICY_URL=
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_ORG_BUDGET_UNITS=5000
AI_GLOBAL_DAILY_REQUEST_LIMIT=200
REQUEST_TIMEOUT_SECONDS=120
# Email production setup (optional until real reset emails are needed)
# EMAIL_MODE=production
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# DEFAULT_FROM_EMAIL=

# Optional external GST lookup adapter; see OCT31_OPERATIONS_UPDATE.md.
# No external lookup occurs until both values are configured.
GST_LOOKUP_URL=
GST_LOOKUP_TOKEN=
